# Copy this file to the repo root as ".env" on the server and fill in real
# values, then run: docker compose -f docker-compose.prod.yml up -d --build
#
# Generate a strong SESSION_SECRET with:  openssl rand -base64 32

POSTGRES_USER=cober
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=cober
SESSION_SECRET=CHANGE_ME_run_openssl_rand_base64_32
